[Unit]
Description=Asistente de IA residente de VasakOS
Documentation=https://github.com/Vasak-OS/vasak-assistant
PartOf=graphical-session.target
After=graphical-session.target
# El demonio no habla con el modelo por TCP: le pide al broker de red, el único
# proceso con AF_INET (#6). `Wants=` lo arranca junto con el demonio y `After=`
# espera a que esté arriba. Es `Wants=`, no `Requires=`, a propósito: si el
# broker queda en `failed` (agota su `StartLimitBurst`), `Requires=` arrastraría
# al demonio a detenerse; con `Wants=` el demonio sigue vivo y el servicio
# responde «modelo no disponible», nunca roto (decisión 2). Un broker caído en
# caliente lo reintenta su propio `Restart=on-failure`.
Wants=vasak-assistant-broker.service
After=vasak-assistant-broker.service
# Si otro proceso ya tiene el nombre del bus, el demonio aborta el arranque
# (#47) y `Restart=on-failure` lo reintenta cada `RestartSec`. El tope de
# arranques de systemd cuenta en una ventana: con el default (10s) y
# `RestartSec=3` los cinco reintentos se reparten en 12s y no entran los cinco
# en la ventana, así que el límite nunca se dispara y el demonio reintenta sin
# fin (el default del host no alcanza). La ventana tiene que cubrir
# `StartLimitBurst * RestartSec`; con 20s los cinco entran y systemd deja la
# unidad en `failed`.
# (StartLimit* van en `[Unit]`, no en `[Service]`: systemd los ignora ahí.)
StartLimitIntervalSec=20s
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/bin/vasak-assistant
Restart=on-failure
# El registro va a stderr (sin colores ni hora propia: journald pone la suya);
# se ve con `journalctl --user -u vasak-assistant`. Es lo que hace systemd por
# omisión, dicho explícito.
StandardError=journal
RestartSec=3
# El backend se elige en la sección `assistant` de ~/.config/vasak/vasak.conf
# (ver el README); la clave de un proveedor, en el llavero. Ninguna de las dos
# cosas va acá.

# El servicio conversa (las conversaciones viven en memoria), lee `vasak.conf`
# y las claves del llavero, habla con un único servidor de modelo y, si la
# persona la encendió, escribe la memoria cifrada en su carpeta de estado. Se
# le saca todo lo demás.
NoNewPrivileges=yes
CapabilityBoundingSet=
# Sólo AF_UNIX: el bus de sesión, el llavero y el socket del broker. **Sin
# AF_INET ni AF_INET6**: el proceso que ve los datos de la persona no puede abrir
# un socket IP. Es la barrera del issue #6, aplicada por el kernel —el gestor de
# usuario de systemd sí aplica esta directiva, a diferencia de `IPAddressAllow`—:
# hablar con el modelo por TCP es cosa del broker (`vasak-assistant-broker.service`),
# el único con esas familias; el demonio le pide por el socket de dominio Unix.
RestrictAddressFamilies=AF_UNIX
# Sin `IPAddressAllow=`/`IPAddressDeny=` ni `RestrictNetworkInterfaces=`: son
# filtros BPF y el gestor de usuario de systemd no los aplica («unit configures
# an IP firewall, but not running as root»); quedarían escritos sin hacer nada.
# Que la conversación no salga de la caja sin permiso lo decide el broker
# (`config.rs` en el crate `ipc`), que además no sigue redirecciones ni usa el
# proxy del entorno (`broker/src/http.rs`).
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# El servicio no genera código en memoria ni lanza nada que lo haga.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Un volcado de memoria tendría conversaciones, la llave de la memoria y, con
# un proveedor remoto, la clave: no se escribe ninguno. (Sin
# `PR_SET_DUMPABLE=0`: la puerta de vasak-keyring identifica al cliente por
# `/proc/<pid>/exe`, y eso lo rompería.)
LimitCORE=0
# Techos de recursos. Las conversaciones están acotadas por los topes del
# contrato (32 conversaciones de hasta 512 KiB, respuestas de hasta 256 KiB,
# cuatro pedidos al modelo a la vez): unas decenas de MiB. El motor de la
# memoria tiene su propio presupuesto de 64 MiB (`daemon/src/memory/mod.rs`), por
# debajo de este techo. Los hilos son los de Tokio (uno por núcleo más los de
# E/S bloqueante); 256 alcanza aun en una máquina con muchos núcleos.
MemoryMax=512M
TasksMax=256

# `strict` y `read-only` en la carpeta personal: todo de sólo lectura (lee
# `vasak.conf`) salvo la carpeta de estado, que systemd crea, deja escribible y
# le pasa en `$STATE_DIRECTORY` (~/.local/state/vasak-assistant). Ahí vive la
# memoria, cifrada y propia del asistente; no va en el almacén de cuentas.
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=vasak-assistant
StateDirectoryMode=0700
# Lo que el servicio cree, sólo para el usuario.
UMask=0077

[Install]
WantedBy=graphical-session.target
