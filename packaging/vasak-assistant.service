[Unit]
Description=Asistente de IA residente de VasakOS
Documentation=https://github.com/Vasak-OS/vasak-assistant
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/vasak-assistant
Restart=on-failure
RestartSec=3
# La dirección de Ollama y el modelo se cambian con
# `systemctl --user edit vasak-assistant`:
#   Environment=VASAK_ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
#   Environment=VASAK_ASSISTANT_MODEL=llama3.2

# En esta fase el servicio sólo conversa: guarda las conversaciones en memoria,
# no escribe nada en disco, no lee datos del usuario y habla con un único
# servidor, Ollama, en la propia máquina. Se le saca todo lo demás.
NoNewPrivileges=yes
CapabilityBoundingSet=
# AF_UNIX para el bus de sesión. AF_INET y AF_INET6 sólo porque Ollama escucha
# por TCP (127.0.0.1:11434): no hay otra forma de hablarle.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Sin `IPAddressAllow=localhost` + `IPAddressDeny=any` ni
# `RestrictNetworkInterfaces=lo`, a propósito: son filtros BPF y el gestor de
# usuario de systemd no los puede aplicar («unit configures an IP firewall, but
# not running as root»); quedarían escritos sin hacer nada. `PrivateNetwork=`
# tampoco sirve: el loopback propio no llega al Ollama de la máquina. Que la
# conversación no salga de la caja lo asegura el servicio: sólo acepta una
# dirección de loopback por http, no sigue redirecciones y no usa el proxy del
# entorno (`daemon/src/config.rs`, `daemon/src/ollama.rs`).
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# El servicio no genera código en memoria ni lanza nada que lo haga.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# `strict`: no escribe nada en ningún lado, así que todo el sistema de archivos
# queda de sólo lectura. `read-only` en la carpeta personal: no la necesita en
# esta fase (la memoria, fase 4, vivirá en el almacén cifrado).
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=graphical-session.target
